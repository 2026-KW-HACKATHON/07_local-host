# No .env is needed for local emulators during development:
# Android uses http://10.0.2.2:8080 and iOS uses http://localhost:8080.

# For a physical phone, replace the value with the development PC's LAN IP.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080

# For release builds, use the deployed HTTPS API.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
