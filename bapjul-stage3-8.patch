+class IssuedCouponTest {
+    @Test void exactly72HoursAndCancelDoesNotRevokeExistingCoupon() {
+        User owner=new User("owner@test", "hash", "점주",UserRole.OWNER);
+        User customer=new User("customer@test", "hash", "손님",UserRole.CUSTOMER);
